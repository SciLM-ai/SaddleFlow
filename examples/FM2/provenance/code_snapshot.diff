+def _local_offline_noise(d, mobile, k, sigma, generator, mode="topk"):
+    """Off-line noise for a line start (see FlowMatchingConfig.line_local_noise_mode), minus its component along
+    d = saddle - start (flattened over all atoms), so it is exactly orthogonal to the reaction line. Mobile atoms only."""
+    mi = mobile.nonzero().squeeze(1)                       # choose among mobile atoms only (never a frozen one)
+    eps = torch.zeros_like(d)
+    if mode == "topk":
+        idx = mi[torch.topk(d[mi].norm(dim=1), min(int(k), len(mi))).indices]
+        eps[idx] = torch.randn((len(idx), 3), generator=generator, dtype=d.dtype).to(d.device) * sigma
+    elif mode == "peratom":
+        w = d[mi].norm(dim=1); w = w / w.max().clamp_min(1e-8)
+        eps[mi] = torch.randn((len(mi), 3), generator=generator, dtype=d.dtype).to(d.device) * (sigma * w[:, None])
+    elif mode == "perdof":
+        w = d[mi].abs(); w = w / w.max().clamp_min(1e-8)
+        eps[mi] = torch.randn((len(mi), 3), generator=generator, dtype=d.dtype).to(d.device) * (sigma * w)
+    else:
+        raise ValueError(f"unknown line_local_noise_mode {mode!r}")
+    dhat = d / d.norm().clamp_min(1e-8)
+    return eps - (eps * dhat).sum() * dhat
+
+
+def seed_perturbation(pos, center, mobile, cell, sigma, radius, generator=None):
+    """N(0, sigma^2) on the mobile atoms within `radius` (A, minimum image) of atom `center` in `pos` (an index, or a
+    list of indices: within `radius` of any of them), those atoms included; zero elsewhere. The seed of a seed start
+    (FlowMatchingConfig.seed_start_prob) and of its inference."""
+    near = torch.zeros(len(pos), dtype=torch.bool, device=pos.device)
+    for c in torch.as_tensor(center).reshape(-1).tolist():
+        near |= mic_displacement(pos, pos[c].expand_as(pos), cell).norm(dim=1) <= radius
+    return gaussian_perturbation(mobile & near, sigma, generator=generator, dtype=pos.dtype)
+
+
+def ellipsoid_perturbation(pos, center, mobile, cell, sigma, ell_min, ell_max, generator=None):
+    """N(0, sigma^2) on the mobile atoms inside an ellipsoid on atom `center` in `pos` with three semi-axes drawn
+    uniformly from [ell_min, ell_max] (A) and a uniformly random orientation (minimum image); zero elsewhere."""
+    axes = ell_min + (ell_max - ell_min) * torch.rand(3, generator=generator, dtype=pos.dtype)
+    w, x, y, z = torch.randn(4, generator=generator, dtype=pos.dtype).tolist()
+    n = (w * w + x * x + y * y + z * z) ** 0.5; w, x, y, z = w / n, x / n, y / n, z / n       # uniform unit quaternion
+    rot = torch.tensor([[1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w)],
+                        [2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w)],
+                        [2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y)]], dtype=pos.dtype)
+    r = mic_displacement(pos, pos[center].expand_as(pos), cell)
+    inside = (((r @ rot.to(pos.device)) / axes.to(pos.device)) ** 2).sum(1) <= 1.0
+    return gaussian_perturbation(mobile & inside, sigma, generator=generator, dtype=pos.dtype)
+
+
+def _cosine(a: torch.Tensor, b: torch.Tensor) -> float:
+    """Cosine between two per-atom displacement sets (flattened)."""
+    a, b = a.reshape(-1), b.reshape(-1).to(a.dtype)
+    return float((a @ b) / (a.norm() * b.norm()).clamp_min(1e-8))
+
